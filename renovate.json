{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "ARG versions in images/*/Dockerfile annotated with a # renovate: comment",
      "managerFilePatterns": ["/^images/.+/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\S+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "cmd/nri-input/containerd226 pins the NRI talos04's containerd vendors; bump it with the node's containerd, by hand",
      "matchFileNames": ["cmd/nri-input/containerd226/go.mod"],
      "enabled": false
    }
  ]
}

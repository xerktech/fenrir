#!/bin/bash
# Runs one dumped PS5 game, $PS5_TITLE_ID (e.g. PPSA01234), from
# $PS5_GAMES_DIR/<title ID> (default /ps5/games): a decrypted dump with
# eboot.bin, its sce_module/ and sce_sys/, and the game's files.
#
# AnyPS5's relinker converts the dump into a native program once per AnyPS5
# version and dump, cached in ~/.cache/anyps5/<version>/<title ID>; a newer
# image (a Renovate bump) converts again. Saves and other game data live in
# ~/.local/share/anyps5/<title ID>, which no AnyPS5 version owns, so they
# survive a bump. The title ID comes from env rather than the command line
# because sway's exec re-splits arguments.
set -euo pipefail

anyps5=${ANYPS5_HOME:-/opt/anyps5}
title=${PS5_TITLE_ID:-}
games=${PS5_GAMES_DIR:-/ps5/games}

fail() {
  echo "launch-ps5: $*" >&2
  exit 1
}

# The ID names directories that get deleted (below), so it must be exactly a
# PS5 title ID: no slashes, no dots.
[[ $title =~ ^[A-Z]{4}[0-9]{5}$ ]] || fail "PS5_TITLE_ID must be a title ID like PPSA01234, not '$title'"

dump=$games/$title
[ -f "$dump/eboot.bin" ] || fail "no game at $dump (expected $dump/eboot.bin)"
# A console executable is an encrypted SELF; the relinker needs the ELF a
# dumper's decrypt option writes.
[ "$(head -c 4 "$dump/eboot.bin" | od -An -tx1 | tr -d ' \n')" = 7f454c46 ] ||
  fail "$dump/eboot.bin is not a decrypted ELF; dump the game with decryption on"

version=$(cat "$anyps5/VERSION")
[[ $version =~ ^[A-Za-z0-9._-]+$ ]] || fail "bad AnyPS5 version '$version'"
cache=$HOME/.cache/anyps5
out=$cache/$version/$title
state=$HOME/.local/share/anyps5/$title

# What the conversion depends on: the AnyPS5 version (in the path) and the
# dump's executable and modules. A changed dump (a game update) converts again.
module_dirs=()
for d in sce_module sce_modules prx; do
  [ -d "$dump/$d" ] && module_dirs+=("$d")
done
stamp=$(cd "$dump" && find eboot.bin "${module_dirs[@]}" -maxdepth 1 -type f -printf '%p %s %T@\n' | sort)

if [ ! -f "$out/.converted" ] || [ "$(cat "$out/.converted")" != "$stamp" ]; then
  echo "launch-ps5: converting $title with AnyPS5 $version" >&2
  mkdir -p "$cache/$version"
  # Built aside and moved into place, so a failed or concurrent conversion
  # never leaves a half-written program at $out.
  tmp=$(mktemp -d "$out.XXXXXX")
  trap 'rm -rf "$tmp"' EXIT
  args=()
  # The relinker requires a module directory; a dump without one gets an
  # empty one.
  if [ ${#module_dirs[@]} -eq 0 ]; then
    mkdir "$tmp/no-modules"
    args+=(--module-dir "$tmp/no-modules")
  fi
  "$anyps5/relinker" "${args[@]}" "$dump/eboot.bin" "$tmp/app.elf"
  rm -rf "$tmp/no-modules"
  # Converted modules are under app0/; the game's own files join them by link
  # (the dump is read-only and large). Titles look for /app0/eboot.bin, so the
  # original stays there too. Top-level links only: AnyPS5 follows those.
  mkdir -p "$tmp/app0"
  for entry in "$dump"/* "$dump"/.[!.]*; do
    [ -e "$entry" ] || continue
    name=${entry##*/}
    [ -e "$tmp/app0/$name" ] || ln -s "$entry" "$tmp/app0/$name"
  done
  ln -s "$anyps5/libs" "$tmp/libs"
  printf '%s\n' "$stamp" > "$tmp/.converted"
  rm -rf "$out"
  # A concurrent launch may have won the move; its conversion is the same.
  mv -T "$tmp" "$out" 2>/dev/null || true
  trap - EXIT
  rm -rf "$tmp"
fi
# Marks this conversion in use, for the sweep below.
touch "$out/.converted"

# Drops conversions not launched for a week, which is how older AnyPS5
# versions' go: no session runs that long, so none is in use by a session still
# on an older image. A game not played for a week just converts again.
find "$cache" -mindepth 3 -maxdepth 3 -name .converted -mtime +7 -printf '%h\n' |
  while read -r old; do
    [ "$old" = "$out" ] || rm -rf "$old"
  done
find "$cache" -mindepth 1 -maxdepth 1 -type d -empty -delete

mkdir -p "$state"
cd "$state"
export ANYPS5_SYSTEM_FONTS=${ANYPS5_SYSTEM_FONTS:-/usr/share/anyps5-fonts}
export ANYPS5_SHADER_CACHE_DIR=${ANYPS5_SHADER_CACHE_DIR:-$cache/shader_cache/$title}
export ANYPS5_FULLSCREEN=${ANYPS5_FULLSCREEN:-1}
echo "launch-ps5: running $title" >&2
exec "$out/app.elf"

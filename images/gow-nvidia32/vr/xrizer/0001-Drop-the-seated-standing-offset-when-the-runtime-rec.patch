+/// Sets the pose of the VIEW reference space (the head) relative to LOCAL.
+pub fn set_view_pose(session: xr::Session, pose: xr::Posef) {
+    session.to_handle().unwrap().view_pose.store(pose);
+}
+
+/// Queues an XrEventDataReferenceSpaceChangePending, as a runtime recenter does.
+pub fn send_reference_space_change_pending(session: xr::Session, ty: xr::ReferenceSpaceType) {
+    let s = session.to_handle().unwrap();
+    send_event(
+        &s.event_sender,
+        xr::EventDataReferenceSpaceChangePending {
+            ty: xr::EventDataReferenceSpaceChangePending::TYPE,
+            next: std::ptr::null(),
+            session,
+            reference_space_type: ty,
+            change_time: xr::Time::from_nanos(0),
+            pose_valid: xr::TRUE,
+            pose_in_previous_space: xr::Posef::IDENTITY,
+        },
+        None,
+    );
+}

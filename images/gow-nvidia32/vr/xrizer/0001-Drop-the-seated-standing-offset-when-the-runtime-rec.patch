+    fn seated_head_pose(data: &OpenXrData<FakeCompositor>) -> xr::Posef {
+        let session = data.session_data.get();
+        session
+            .view_space
+            .locate(
+                session.get_space_for_origin(openvr::ETrackingUniverseOrigin::Seated),
+                xr::Time::from_nanos(1),
+            )
+            .unwrap()
+            .pose
+    }
+
+    fn assert_pose_eq(actual: xr::Posef, expected: xr::Posef) {
+        let p = |p: xr::Posef| {
+            [
+                p.position.x,
+                p.position.y,
+                p.position.z,
+                p.orientation.x,
+                p.orientation.y,
+                p.orientation.z,
+                p.orientation.w,
+            ]
+        };
+        for (a, e) in p(actual).into_iter().zip(p(expected)) {
+            assert!((a - e).abs() < 1e-4, "{actual:?} != {expected:?}");
+        }
+    }
+
+    #[test]
+    fn local_recenter_clears_seated_offset() {
+        crate::init_logging();
+        let data = OpenXrData::<FakeCompositor>::new(&Injector::default()).unwrap();
+        let raw = data.session_data.get().session.as_raw();
+        // Head off-centre, 1.2 m up, turned 30 degrees.
+        let (s, c) = (15f32.to_radians().sin(), 15f32.to_radians().cos());
+        let head = xr::Posef {
+            position: xr::Vector3f {
+                x: 0.3,
+                y: 1.2,
+                z: -0.2,
+            },
+            orientation: xr::Quaternionf {
+                x: 0.0,
+                y: s,
+                z: 0.0,
+                w: c,
+            },
+        };
+        fakexr::set_view_pose(raw, head);
+        assert_pose_eq(seated_head_pose(&data), head);
+
+        // The game recenters: Seated is now the head, at its height.
+        data.reset_tracking_space(openvr::ETrackingUniverseOrigin::Seated);
+        assert_pose_eq(seated_head_pose(&data), xr::Posef::IDENTITY);
+
+        // A STAGE change leaves the seated offset alone.
+        fakexr::send_reference_space_change_pending(raw, xr::ReferenceSpaceType::STAGE);
+        data.poll_events();
+        assert_pose_eq(seated_head_pose(&data), xr::Posef::IDENTITY);
+
+        // The runtime recenters LOCAL: Seated follows LOCAL again, so the
+        // runtime's recenter is not applied on top of the game's.
+        fakexr::send_reference_space_change_pending(raw, xr::ReferenceSpaceType::LOCAL);
+        data.poll_events();
+        assert_pose_eq(seated_head_pose(&data), head);
+    }
+

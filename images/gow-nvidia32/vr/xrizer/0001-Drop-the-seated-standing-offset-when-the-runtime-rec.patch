+    /// Drops any offset set by `reset_tracking_space` from the adjusted
+    /// space of `ty`, so it follows the runtime's own space again.
+    fn clear_tracking_space_offset(&mut self, ty: xr::ReferenceSpaceType) {
+        let adjusted = match ty {
+            xr::ReferenceSpaceType::LOCAL => &mut self.local_space_adjusted,
+            xr::ReferenceSpaceType::STAGE => &mut self.stage_space_adjusted,

#! /bin/bash

# Starts Ferestre's window in a direwolf session (target ferestre, on trial
# against Xodus Nexus: XERK-2471). Like xodus-nexus, it gives Ferestre's Xbox
# client the session bus and unlocked Secret Service keyring it keeps the
# Microsoft account in; without them every account call panics.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
  exec dbus-run-session -- "$0" "$@"
fi
if ! dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus.NameHasOwner string:org.freedesktop.secrets 2>/dev/null | grep -q 'boolean true'; then
  # Its own keyring directory, not Nexus's ~/.local/share/keyrings: both run
  # the Xodus client, whose entries would collide, so a Ferestre sign-in could
  # replace Nexus's. Only the daemon sees this XDG_DATA_HOME. Unlocked with an
  # empty password as xodus-nexus does (see it for why two calls).
  keyrings="${HOME}/.local/share/ferestre-keyring"
  mkdir -p "${keyrings}/keyrings"
  eval "$(printf '\n' | XDG_DATA_HOME="${keyrings}" gnome-keyring-daemon --unlock --components=secrets)"
  export GNOME_KEYRING_CONTROL
  eval "$(XDG_DATA_HOME="${keyrings}" gnome-keyring-daemon --start --components=secrets)"
  export GNOME_KEYRING_CONTROL
fi

# Games go on the shared games volume, not into the home (Ferestre's default
# is ~/xbox-games). An explicit value is kept.
export XODUS_GAMES_DIR="${XODUS_GAMES_DIR:-/games/ferestre}"
mkdir -p "${XODUS_GAMES_DIR}" || echo "ferestre-session: could not create ${XODUS_GAMES_DIR}" >&2

exec ferestre-gui "$@"

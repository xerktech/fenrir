#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# One Steam install for the Library and game sessions (XERK-1559). They share
# the Steam home, but each launcher keeps its own: the sessions' Debian one
# uses ~/.steam/debian-installation, Valve's one here ~/.local/share/Steam.
# Each points ~/.steam/steam at its own dir by an absolute path the other pod
# lacks, so each fell back to its own install and neither saw the other's
# games. The sessions' path wins (only this image is ours to change), and
# ~/.local/share/Steam becomes a relative link to it, valid in both pods and
# the path the catalogue and the downloads check read.

# As the desktop user: the home is user-writable, and root would follow
# links planted there.
if [[ "$(id -u)" == 0 ]]; then
  exec s6-setuidgid abc "$0"
fi

canon="${HOME}/.steam/debian-installation"
link="${HOME}/.local/share/Steam"
target="../../.steam/debian-installation"

if [[ -L "${canon}" ]]; then
  echo "init-steam-home: ${canon} is a symlink, leaving the Steam home as it is" >&2
  exit 0
fi

if [[ -e "${link}" && ! -L "${link}" ]]; then
  if [[ ! -e "${canon}" ]]; then
    # Only the Library has run here: its install becomes the shared one.
    mkdir -p "${canon%/*}" && mv "${link}" "${canon}" || exit 1
  else
    # Both have run. Never delete: a login or a game may be in it.
    aside="${link}.library-$(date +%Y%m%d%H%M%S)"
    echo "init-steam-home: moving the Library's own Steam install aside to ${aside}"
    mv "${link}" "${aside}" || exit 1
  fi
fi

# Valve's launcher can't install through a link to a missing dir.
mkdir -p "${canon}" "${link%/*}" || exit 1
if [[ "$(readlink "${link}")" != "${target}" ]]; then
  ln -sfn "${target}" "${link}" || exit 1
fi

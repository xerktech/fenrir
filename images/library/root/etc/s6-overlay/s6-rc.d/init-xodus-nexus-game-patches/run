#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# Installs the patched xgameruntime.dll for the listed games after the runtime
# is in place; see xodus-nexus-game-patches. Works only in the desktop user's
# home, so it runs as that user.
#
# Never exits non-zero: a failed oneshot stops s6 starting the desktop and
# leaves the pod Running but never Ready, which would hold the Steam lock.

home="$(getent passwd abc | cut -d: -f6)"
[[ -n "${home}" ]] || { echo "init-xodus-nexus-game-patches: cannot find abc's home" >&2; exit 0; }
HOME="${home}" timeout 600 s6-setuidgid abc /usr/local/bin/xodus-nexus-game-patches ||
  echo "init-xodus-nexus-game-patches: timed out or failed; games keep their current xgameruntime.dll" >&2
exit 0

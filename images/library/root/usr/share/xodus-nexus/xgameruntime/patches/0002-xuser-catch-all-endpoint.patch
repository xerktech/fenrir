From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Malcolm Habeeb <malcolm.habeeb@gmail.com>
Date: Tue, 3 Nov 2026 19:29:32 -0500
Subject: [PATCH] fix(xuser): match a catch-all "*" endpoint and report no
 token required for it

A title's catch-all "*" endpoint (HostType wildcard, no RelyingParty or
TokenType) never matched: match_wildcard stopped once the pattern was used
up, so a trailing '*' could not absorb the rest of the host. Such titles'
own services then got an XSTS token for https://<host>, which XSTS
rejects with 400, so sign-in failed (007 First Light: no online play).
Trailing '*' now matches the rest, and hosts compare case-insensitively.

A matched entry without a token type now completes with
E_GAMEUSER_NO_TOKEN_REQUIRED, as on Windows, instead of success with no
token, which crashes 007 First Light at its title screen.

Test: NexusAuthentication.CatchAllWildcardEndpointMatchesEveryHostWithoutAToken.
---
 src/System/XUser.cpp      | 32 ++++++++++++++++++++++++--------
 tests/Nexus/test_user.cpp | 28 ++++++++++++++++++++++++++++
 2 files changed, 52 insertions(+), 8 deletions(-)

diff --git a/src/System/XUser.cpp b/src/System/XUser.cpp
index 7ea2561..768b8dc 100644
--- a/src/System/XUser.cpp
+++ b/src/System/XUser.cpp
@@ -1289,23 +1289,29 @@ static HRESULT user_wait_init( XUserHandle user )
     return hr;
 }
 
+/* Glob match of an endpoint host pattern ('*' any run, '?' any one character),
+ * backtracking to the most recent '*'. A trailing '*' still matches once the
+ * input is exhausted, so a title's catch-all "*" entry matches every host, as
+ * on Windows; without that, such titles fall back to an XSTS token for
+ * https://<host>, which XSTS rejects with 400. Hosts compare
+ * case-insensitively, like the exact entries in GetEndpointInfo. */
 static BOOLEAN match_wildcard( const WCHAR *pat, UINT32 patLen, const WCHAR *inp, UINT32 inpLen )
 {
-    UINT32 lastMatch = -1, lastWildcard = -1, patOff = 0, inpOff = 0;
+    UINT32 lastMatch = 0, lastWildcard = ~0u, patOff = 0, inpOff = 0;
 
-    while ( inpOff < inpLen && patOff < patLen )
+    while ( inpOff < inpLen )
     {
-        if ( pat[patOff] == '*' )
+        if ( patOff < patLen && pat[patOff] == '*' )
         {
             lastWildcard = patOff++;
             lastMatch = inpOff;
         }
-        else if ( pat[patOff] == '?' || pat[patOff] == inp[inpOff] )
+        else if ( patOff < patLen && ( pat[patOff] == '?' || !wcsnicmp( pat + patOff, inp + inpOff, 1 ) ) )
         {
             patOff++;
             inpOff++;
         }
-        else if ( lastWildcard != -1 )
+        else if ( lastWildcard != ~0u )
         {
             patOff = lastWildcard + 1;
             inpOff = ++lastMatch;
@@ -1313,8 +1319,9 @@ static BOOLEAN match_wildcard( const WCHAR *pat, UINT32 patLen, const WCHAR *inp
         else
             return FALSE;
     }
+    while ( patOff < patLen && pat[patOff] == '*' ) patOff++;
 
-    return inpOff == inpLen && patOff == patLen;
+    return patOff == patLen;
 }
 
 HRESULT WINAPI XUser::GetEndpointInfo( const char *url, struct endpoint *info )
@@ -2218,8 +2225,17 @@ static HRESULT WINAPI token_signature_phase( XAsyncOp op, const XAsyncProviderDa
             info.relyingParty = ownedParty;
             info.tokenType = ownedType;
         }
-        if ( info.tokenType &&
-             FAILED( hr = ( context->user )
+        /* A matched entry without a token type (a title's catch-all "*" host,
+         * with empty RelyingParty and TokenType) needs no token. Report it as
+         * E_GAMEUSER_NO_TOKEN_REQUIRED, which XSAPI treats as "send no auth
+         * headers", as on Windows; success with no token crashes 007 First
+         * Light at its title screen. */
+        if ( !WindowsGetStringLen( info.tokenType ) )
+        {
+            hr = E_GAMEUSER_NO_TOKEN_REQUIRED;
+            goto complete;
+        }
+        if ( FAILED( hr = ( context->user )
                               ->GetAuthorization( WindowsGetStringRawBuffer( info.relyingParty, NULL ), &auth ) ) )
             goto complete;
 
diff --git a/tests/Nexus/test_user.cpp b/tests/Nexus/test_user.cpp
index 2c2f6e9..a5b54e6 100644
--- a/tests/Nexus/test_user.cpp
+++ b/tests/Nexus/test_user.cpp
@@ -1315,3 +1315,31 @@ TEST( NexusOfflineIdentity, AStaleIdentityIsNotUsed )
     EXPECT_EQ( user->SignInOffline( Unreachable ), Unreachable );
     EXPECT_EQ( user->xuid, 0u );
 }
+TEST( NexusAuthentication, CatchAllWildcardEndpointMatchesEveryHostWithoutAToken )
+{
+    // 007 First Light declares a catch-all "*" host with no relying party or
+    // token type after its exact Xbox entries. It must match any host (in any
+    // case) so the title's own services get no XSTS token, while exact and
+    // partial patterns keep their meaning.
+    Apartment apartment;
+    SyntheticTransport transport;
+    transport.currentEndpoints =
+        R"({"EndPoints":[{"Protocol":"https","Host":"*.Example.invalid","HostType":"wildcard","RelyingParty":"https://wild.example.invalid/","TokenType":"JWT"},)"
+        R"({"Protocol":"https","Host":"*","HostType":"wildcard"}]})";
+    auto user = CreateUser( transport );
+    ASSERT_EQ( user->InitializeNetwork( XUserAddOptions::AddDefaultUserSilently ), S_OK );
+    user->initDone = 1;
+    user->initResult = S_OK;
+
+    endpoint info{};
+    ASSERT_EQ( user->GetEndpointInfo( "https://API.example.INVALID/v1", &info ), S_OK );
+    EXPECT_STREQ( WindowsGetStringRawBuffer( info.relyingParty, nullptr ), L"https://wild.example.invalid/" );
+
+    info = {};
+    ASSERT_EQ( user->GetEndpointInfo( "https://storage.title.example.com/saves", &info ), S_OK );
+    EXPECT_EQ( WindowsGetStringLen( info.tokenType ), 0u );
+    EXPECT_EQ( WindowsGetStringLen( info.relyingParty ), 0u );
+
+    info = {};
+    EXPECT_EQ( user->GetEndpointInfo( "http://storage.title.example.com/saves", &info ), E_FAIL );
+}

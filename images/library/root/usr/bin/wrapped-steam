#! /bin/bash

# Replaces the base image's /usr/bin/wrapped-steam (XERK-1815). That one runs
# Steam inside a full-screen terminal (`foot -e steam` on Wayland), which
# covers the labwc desktop: minimising Steam leaves its log in the way, so the
# right-click menu, the only way to open Heroic, cannot be reached. Here Steam
# runs without a terminal, its output goes to a log, and Heroic starts beside
# it. This file is the hook because the labwc autostart, copied to the shared
# home on first run and never refreshed, calls only /usr/bin/wrapped-steam.

LOG_DIR="${HOME}/.local/state/library"
mkdir -p "${LOG_DIR}"

# The taskbar's start menu and Steam's own shortcuts also land here (via the
# /usr/local/bin/steam shim and steam.desktop). With Steam already up, hand
# the request (a steam:// URL, say) to the running client and start nothing.
# steam.sh too: Valve's launcher runs it (as the parent of the real client)
# before any process is named steam, for seconds on a bootstrap update.
STEAM_PROCS='steam|steam\.sh'
if pgrep -x "${STEAM_PROCS}" >/dev/null; then
  exec /usr/bin/steam "$@"
fi

# Two cold launches at once (a double-click in the start menu) would both pass
# that check and start Steam and Heroic twice, the second truncating the logs.
# So check again under a per-pod lock, held until Steam is exec'd below. No
# child may inherit fd 9 (hence 9>&-): one outliving this script would make
# every later cold launch wait out the timeout. Never block a launch for good.
exec 9>"/tmp/wrapped-steam-$(id -u).lock"
flock -w 30 9 || echo "wrapped-steam: no launch lock (timed out or unavailable), starting anyway" >&2
if pgrep -x "${STEAM_PROCS}" >/dev/null; then
  exec /usr/bin/steam "$@" 9>&-
fi

# The home's ~/Desktop copy of steam.desktop predates this image and names
# /usr/bin/steam directly, bypassing this wrapper; repoint it (idempotent).
if [ -f "${HOME}/Desktop/steam.desktop" ]; then
  sed -i 's|^Exec=/usr/bin/steam|Exec=/usr/bin/wrapped-steam|' "${HOME}/Desktop/steam.desktop"
fi

# Heroic writes this flag into the shared Steam install when it cannot reach
# Steam; Steam then serves its CEF remote debugger on 127.0.0.1:8080, where any
# process in this pod could drive the client. Session pods delete it too
# (gow-nvidia32's 20-steam-input-off.sh), as they share the install.
CEF_FLAGS=("${HOME}/.local/share/Steam/.cef-enable-remote-debugging"
  "${HOME}/.steam/steam/.cef-enable-remote-debugging")
rm -f "${CEF_FLAGS[@]}"

# 64 and 32 bit input interposers and fake udev for gamepads
STEAM_PRELOAD="/usr/lib/selkies_input_interposer.so:/usr/lib/libudev.so.1.0.0-fake:/usr/lib/selkies_input_interposer_32.so:/usr/lib/libudev.so.1.0.0-fake_32"
PROOT_BWRAP="${HOME}/.local/bin/proot-bwrap"
STEAM_ARGS=()

# Wayland check
if [ "${PIXELFLUX_WAYLAND,,}" == "true" ]; then
  STEAM_ARGS+=(--ozone-platform=wayland)
fi

bwrap_works() {
  env -u LD_PRELOAD bwrap \
    --ro-bind / / \
    --dev /dev \
    --proc /proc \
    --unshare-pid \
    /bin/true >/dev/null 2>&1
}

if bwrap_works; then
  echo "wrapped-steam: user namespaces are available, using bubblewrap"
  unset BWRAP
else
  echo "wrapped-steam: user namespaces are not available, falling back to proot-bwrap"
  export BWRAP="${BWRAP:-${PROOT_BWRAP}}"
  if [ ! -x "${BWRAP}" ]; then
    echo "wrapped-steam: ${BWRAP} is missing or not executable, Steam will not be able to launch games" >&2
  fi
  STEAM_ARGS+=(-no-cef-sandbox)
fi

# setsid: Heroic must outlive this script's session (it otherwise dies with
# its stdout); wrapped-heroic sets its own preloads.
if ! pgrep -x heroic >/dev/null; then
  setsid -f /usr/bin/wrapped-heroic >"${LOG_DIR}/heroic.log" 2>&1 </dev/null 9>&-
fi

# Steam restarts itself in place (exit 42: a self-update or a settings
# restart) without coming back here, and Heroic may have written the flag
# meanwhile. So keep deleting it for as long as Steam (or steam.sh) runs. One
# guard per Library: a second cold launch finds its lock held. The lock file
# is made here, not by the detached guard, which may start after we exit.
GUARD_LOCK="${LOG_DIR}/cef-flag-guard.lock"
: >>"${GUARD_LOCK}"
STEAM_PROCS="${STEAM_PROCS}" setsid -f flock -n "${GUARD_LOCK}" bash -c \
  'while :; do rm -f "$@"; sleep 1; pgrep -x "${STEAM_PROCS}" >/dev/null || exit 0; done' \
  cef-flag-guard "${CEF_FLAGS[@]}" >/dev/null 2>&1 </dev/null 9>&-

export LD_PRELOAD="${STEAM_PRELOAD}"
# In the foreground, as the base image ran it.
exec /usr/bin/steam "${STEAM_ARGS[@]}" "$@" >"${LOG_DIR}/steam.log" 2>&1 </dev/null 9>&-

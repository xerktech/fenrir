#! /bin/bash

# Heroic counterpart of the base image's /usr/bin/wrapped-steam: same gamepad
# preloads, same Wayland switch, same user-namespace fallback.

# 64 and 32 bit input interposers and fake udev for gamepads
export LD_PRELOAD="/usr/lib/selkies_input_interposer.so:/usr/lib/libudev.so.1.0.0-fake:/usr/lib/selkies_input_interposer_32.so:/usr/lib/libudev.so.1.0.0-fake_32"
HEROIC_ARGS=()

if [ "${PIXELFLUX_WAYLAND,,}" == "true" ]; then
  HEROIC_ARGS+=(--ozone-platform=wayland)
fi

# Electron's sandbox needs unprivileged user namespaces, which a default
# container seccomp profile denies.
if ! env -u LD_PRELOAD bwrap --ro-bind / / --dev /dev --proc /proc --unshare-pid /bin/true >/dev/null 2>&1; then
  echo "wrapped-heroic: user namespaces are not available, running without the Chromium sandbox"
  HEROIC_ARGS+=(--no-sandbox)
fi

# Turn "Add games to Steam" off. Heroic edits Steam's shortcuts only while
# Steam is closed or through Steam's CEF debugger, and here Steam always runs
# and its debugger stays off (sessions delete Heroic's flag for it: their
# Steam shares the node's loopback). So every install with it on fails with a
# "Steam is running" error, and the shortcut it did add is never removed.
# Heroic's own default is off; homes from older versions saved it on.
env -u LD_PRELOAD python3 -I - "${XDG_CONFIG_HOME:-${HOME}/.config}/heroic/config.json" <<'EOF' ||
import json, os, sys, tempfile

path = sys.argv[1]
if not os.path.isfile(path):
    sys.exit(0)  # Fresh home: Heroic writes its default, off.
with open(path, encoding="utf-8") as f:
    config = json.loads(f.read(16 << 20))
settings = config.get("defaultSettings")
if not isinstance(settings, dict) or settings.get("addSteamShortcuts") is not True:
    sys.exit(0)
settings["addSteamShortcuts"] = False
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".config.json.")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(config, f, indent=2)
    os.chmod(tmp, os.stat(path).st_mode & 0o777)
    os.replace(tmp, path)
except BaseException:
    os.unlink(tmp)
    raise
EOF
  echo "wrapped-heroic: could not turn off Heroic's \"Add games to Steam\"" >&2

exec /opt/Heroic/heroic "${HEROIC_ARGS[@]}" "$@"
